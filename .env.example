# Copy to .env and fill in. .env is gitignored.

# Free key from https://finnhub.io (no credit card required).
FINNHUB_API_KEY=

# Postgres connection string. The value below points at the docker-compose service.
DATABASE_URL=postgresql://app:app@postgres:5432/market

# Matching engine (synthetic exchange). Defaults match docker-compose.
MATCHING_ENGINE_URL=http://matching-engine:8080
ME_SYMBOLS=SYNTH1,SYNTH2
ME_SEED=42
ME_BASE_PRICE=100.00
